{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "url": {
      "type": "string",
      "maxLength": 127,
      "default": ""
    },
    "username": {
      "type": "string",
      "maxLength": 63,
      "default": ""
    },
    "broker_password": {
      "type": "string",
      "maxLength": 63,
      "default": ""
    },
    "client_id": {
      "type": "string",
      "maxLength": 63,
      "default": ""
    },
    "topic_prefix": {
      "type": "string",
      "maxLength": 63,
      "default": ""
    },
    "ca_file": {
      "type": "string",
      "maxLength": 127,
      "default": ""
    },
    "cert_set": {
      "type": "string",
      "maxLength": 24,
      "default": ""
    },
    "keepalive_s": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600,
      "default": 30
    },
    "connect_on": {
      "type": "string",
      "enum": [
        "wifi",
        "any"
      ],
      "default": "wifi"
