{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "url": {
      "type": "string",
      "maxLength": 191,
      "default": ""
    },
    "url2": {
      "type": "string",
      "maxLength": 191,
      "default": ""
    },
    "interval_s": {
      "type": "integer",
