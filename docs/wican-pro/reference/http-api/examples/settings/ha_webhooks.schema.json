    "gzip": {
      "type": "boolean",
      "default": false
    },
    "manual_override": {
      "type": "boolean",
      "default": false
    },
    "cert_set": {
      "type": "string",
      "maxLength": 31,
      "default": ""
    },
    "cli": {
      "type": "boolean",
      "default": true
    }
  }
}
