{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "destinations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "default": ""
          },
          "type": {
            "type": "string",
            "enum": [
              "mqtt",
              "http",
              "https",
              "abrp"
            ],
            "default": "mqtt"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "url": {
            "type": "string",
            "maxLength": 255,
            "default": ""
          },
          "period_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400,
            "default": 5
          },
          "auth": {
            "type": "string",
            "enum": [
              "none",
              "bearer",
              "api_key_header",
              "api_key_query",
              "basic"
            ],
            "default": "none"
          },
          "auth_token": {
            "type": "string",
            "maxLength": 255,
            "default": ""
          },
          "auth_name": {
            "type": "string",
            "maxLength": 63,
            "default": ""
          },
          "basic_username": {
            "type": "string",
            "maxLength": 63,
            "default": ""
          },
          "basic_password": {
            "type": "string",
            "maxLength": 63,
            "default": ""
          },
          "api_key": {
            "type": "string",
            "maxLength": 255,
            "default": ""
          },
          "query": {
            "type": "string",
            "maxLength": 255,
            "default": ""
          },
          "cert_set": {
            "type": "string",
            "maxLength": 24,
            "default": ""
          },
          "car_model": {
            "type": "string",
            "maxLength": 63,
            "default": ""
          },
          "retain": {
            "type": "boolean",
            "default": true
          },
          "full_first": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "default": []
    },
    "cli": {
      "type": "boolean",
      "default": true
